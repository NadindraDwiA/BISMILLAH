<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- 1GB+ model packs must never go to cloud backup; re-downloadable. -->
        <exclude domain="file" path="models/" />
        <!-- Setup flag (DataStore file) is device-local. -->
        <exclude domain="file" path="datastore/setup.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="models/" />
    </device-transfer>
</data-extraction-rules>
